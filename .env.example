# =============================================================================
# KaamSetu — copy values into:
#   apps/api/.env     (API — Nest loads this, then ../../.env)
#   apps/mobile/.env  (Expo — EXPO_PUBLIC_* only)
#   .env              (optional root fallback for API)
# Never commit real secrets.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://kaamsetu:kaamsetu@localhost:5433/kaamsetu?schema=public

# --- HTTP ---
PORT=3000
# Comma-separated origins, or * for any (dev). Used by HTTP CORS + WebSocket origin check.
CORS_ORIGIN=*
# Optional public base URL (docs / future webhooks). Not required at runtime today.
# API_PUBLIC_URL=http://localhost:3000
NODE_ENV=development

# --- Auth (passwordless mobile OTP) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# SMS OTP: msg91 (India, production) | twilio | console (local only — logs OTP, no SMS)
# Use console until MSG91/Twilio keys are filled. Production must NOT use console.
# If OTP_SMS_PROVIDER is omitted, auto-picks msg91 → twilio → console from keys present.
OTP_SMS_PROVIDER=console
OTP_PHONE_DEFAULT_COUNTRY=91
# Return OTP in API JSON — local/dev only; set false when using real SMS
OTP_DEV_EXPOSE=true

# MSG91 (India DLT OTP) — set these, then OTP_SMS_PROVIDER=msg91 and OTP_DEV_EXPOSE=false
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_SENDER_ID=KAMSET

# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...

# --- Admin onboarding (optional) ---
# Default: first OTP register (no admin yet) → ADMIN; later registers → WORKER.
# Leave unset for normal use. Set only for recovery / locked deploys.
# ADMIN_BOOTSTRAP_SECRET=long-random-secret-at-least-8-chars
# ADMIN_BOOTSTRAP_PHONE=98XXXXXXXX
# ADMIN_BOOTSTRAP_NAME=Organization Admin
# ADMIN_BOOTSTRAP_REQUIRE_SECRET=false
# ADMIN_BOOTSTRAP_FORCE_PROMOTE=false

# --- Sarvam AI (STT / TTS / Translate) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_enhi_ads

# --- LLM: xAI Grok (xai-*) or Groq (gsk_*) ---
XAI_API_KEY=
XAI_MODEL=openai/gpt-oss-20b
XAI_API_BASE=https://api.groq.com/openai/v1

# --- Cloudinary (voice audio store) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AUDIO_STORE_ENABLED=true

# --- Firebase Admin (FCM) — service-account file AND/OR inline credentials ---
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Quote the key; keep \n escapes on one line
FIREBASE_PRIVATE_KEY=

# --- Voice ---
VOICE_REQUIRE_CONFIRMATION_BELOW=0.75

# --- Mobile (apps/mobile/.env) ---
# Emulator default is http://10.0.2.2:3000 when unset in __DEV__.
# Physical device / LAN — set your machine IP:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
