# Copy to apps/api/.env and fill real values

# Database
DATABASE_URL=postgresql://kaamsetu:kaamsetu@localhost:5433/kaamsetu?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Server
PORT=3000
CORS_ORIGIN=*
API_PUBLIC_URL=http://localhost:3000

# Sarvam AI (STT / TTS / Translate)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_enhi_ads

# LLM — xAI Grok (xai-*) or Groq (gsk_*). Groq free tier: openai/gpt-oss-20b
XAI_API_KEY=
XAI_MODEL=openai/gpt-oss-20b
XAI_API_BASE=https://api.groq.com/openai/v1

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin (FCM) — prefer service account file
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Voice
VOICE_REQUIRE_CONFIRMATION_BELOW=0.75
AUDIO_STORE_ENABLED=true

# Mobile (apps/mobile) — set when testing on a physical device / LAN
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000