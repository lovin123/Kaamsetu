{
  "name": "kaamsetu",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run start:dev -w @kaamsetu/api",
    "api:build": "npm run build -w @kaamsetu/api",
    "mobile": "npm run start -w @kaamsetu/mobile",
    "mobile:android": "npm run android -w @kaamsetu/mobile",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate -w @kaamsetu/api",
    "prisma:migrate": "npm run prisma:migrate -w @kaamsetu/api",
    "prisma:seed": "npm run prisma:seed -w @kaamsetu/api",
    "shared:build": "npm run build -w @kaamsetu/shared"
  },
  "engines": {
    "node": ">=20"
  }
}
